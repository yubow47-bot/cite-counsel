# Cite Counsel local Chatbox secrets. Copy to .env, or enter them on the local settings page.
# Models, port and spend cap live in config/chatbox.local.json (see config/chatbox.example.json).

# Required for text and image recognition: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Recommended: JEV fast query routing + document-classification comparison: https://console.typesafe.ai
# Without it, query routing falls back to a slower full LLM call.
TYPESAFE_API_KEY=
