# 已禁用（实验副本 E:\mcgill-实验版）
# 原文件: .github/workflows/sync-to-hf.yml
# 原因: 该 workflow 在 push 到 main 时会把仓库同步上传到现有 HF Space。
#       实验副本禁止自动部署到当前 HF/生产目标，故移出 workflows/ 目录。
# 如需在实验副本中恢复，请先确认目标 Space 不是生产 Space。

name: Sync to Hugging Face Space

on:
  push:
    branches: [main]

jobs:
  sync:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # Strip sensitive/non-runtime files before syncing to the public Space.
      # This runs on the CI runner's throwaway checkout only — does NOT
      # alter the private GitHub repo.
      - name: Strip non-runtime files
        run: |
          rm -rf \
            docs/ \
            eval/ \
            tests/ \
            frontend/ \
            .claude/ \
            .vscode/ \
            .gradio/ \
            debug_prompt.txt \
            diag_result.json \
            MCGILL_AUDIT_INIT.md \
            SYSTEM_STATE_MACHINE.md \
            api_contract.md \
            REVIEW_REQUEST.md \
            test_cases.json \
            test_italic_manual.py \
            main.py

          # Strip data/ contents but keep the directory for runtime writes
          rm -f data/*.json data/*.docx
          touch data/.gitkeep

      # Upload the stripped local tree to HF Space via huggingface_hub Python API.
      # Script lives in .github/scripts/ — kept out of the public Space because
      # .github/* is in ignore_patterns below. The inline heredoc approach broke
      # YAML parsing (block-scalar indentation conflict).
      - name: Upload stripped tree to HF Space
        env:
          HF_TOKEN: ${{ secrets.HF_TOKEN }}
          HF_SPACE_ID: ${{ vars.HF_SPACE_ID }}
        run: |
          pip install huggingface_hub==1.20.1
          python .github/scripts/sync_upload.py
