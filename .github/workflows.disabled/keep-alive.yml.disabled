# 已禁用（实验副本 E:\mcgill-实验版）
# 原文件: .github/workflows/keep-alive.yml
# 原因: 每 15 分钟 ping 生产 HF Space 的健康检查 URL（vars.HF_HEALTH_URL）。
#       实验副本不应向生产目标发任何请求，故移出 workflows/ 目录。

name: Keep HF Space Alive

on:
  schedule:
    - cron: "*/15 * * * *"
  workflow_dispatch:

jobs:
  ping:
    runs-on: ubuntu-latest
    steps:
      - name: Health check
        run: curl -fsS "${{ vars.HF_HEALTH_URL }}" > /dev/null 2>&1 || echo "Health check failed (non-fatal)"
